format: antigravity-v1
source: DEVELOPMENT_GUIDELINES.md
enforce: true
compatible_agents:
  - "opus-4.5"
description: |
  Machine-readable policy for the "antigravity" automation/agent integration.
  Any agent identifying this file MUST follow the repository development
  guidelines. Key checks summarized below; refer to DEVELOPMENT_GUIDELINES.md
  for full rules.
checks:
  - name: tenant_model_inheritance
    requirement: "Models that contain tenant data must inherit TenantAwareModel"
  - name: rls_present
    requirement: "Row Level Security policies must exist for new tenant tables"
  - name: migrations_via_manage
    requirement: "Migrations must be generated by 'python manage.py makemigrations'"
  - name: tests_added
    requirement: "Add tests for new APIs/features; run test suite before proposing merge"
  - name: no_secrets
    requirement: "Do not commit secrets or credentials in repository"
policy:
  on_detect_violation: "halt_and_request_human_review"
  human_approval_required_for: ["rls_changes", "prod_db_migrations", "env_changes"]
agent_specific:
  opus-4.5:
    preflight_checks:
      - "validate_tenant_model_inheritance"
      - "detect_rls_changes"
      - "ensure_no_secrets_committed"
      - "run_test_suite"
    run_commands:
      - "python manage.py makemigrations --dry-run"
      - "python manage.py test"
    on_violation: "halt_and_request_human_review"
notes: |
  Place this file at the repository root so CI and third-party agents named
  "antigravity" can discover it. Keep DEVELOPMENT_GUIDELINES.md as the
  authoritative human-readable doc.
