# Cloud Run environment variables — copy to Secret Manager, not committed to git
# All secrets should be stored in Google Secret Manager and mounted via Cloud Run secrets.

# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.cloudrun
SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(50))">
DEBUG=False
ALLOWED_HOSTS=*

# ── Database (Cloud SQL PostgreSQL) ─────────────────────────────────────────
# Format for Cloud SQL Unix socket (used when Cloud SQL Auth Proxy sidecar is configured):
#   postgresql://USER:PASS@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# Format for TCP (internal VPC):
#   postgresql://USER:PASS@10.x.x.x:5432/DBNAME
DATABASE_URL=postgresql://nucleiq_user:STRONG_PASSWORD@/nucleiq?host=/cloudsql/YOUR_PROJECT:asia-south1:nucleiq-db

# ── Google Cloud Storage (media files) ──────────────────────────────────────
GCS_BUCKET_NAME=YOUR_PROJECT-nucleiq-media

# ── Cloud Scheduler security ─────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHEDULER_SECRET=<generate a strong random token>

# ── Email (Gmail App Password recommended for Indian schools) ────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-school@gmail.com
EMAIL_HOST_PASSWORD=<gmail-app-password>
DEFAULT_FROM_EMAIL=Your School <your-school@gmail.com>

# ── Payment Gateways ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=<razorpay-secret>
RAZORPAY_WEBHOOK_SECRET=<webhook-secret>

# ── SMS / WhatsApp (India — MSG91 recommended, cheaper than Twilio) ──────────
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=<your-msg91-key>
MSG91_SENDER_ID=SCHOOL
MSG91_ROUTE=4

# ── Frontend URL ─────────────────────────────────────────────────────────────
FRONTEND_URL=https://YOUR_FRONTEND_CLOUD_RUN_URL

# ── Gunicorn tuning ──────────────────────────────────────────────────────────
# Cloud Run: 1 vCPU → keep workers low, rely on threads
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
LOG_LEVEL=info
