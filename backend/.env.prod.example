# Production environment variables for Django backend
# Copy this file to .env.prod and fill in the values

# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=<generated-by-azure-keyvault>
DEBUG=False
ALLOWED_HOSTS=nucleiq-backend.*.azurecontainerapps.io,api.nucleiq.io

# =============================================================================
# DATABASE (Azure PostgreSQL Flexible Server)
# =============================================================================
DB_HOST=nucleiq-db-server.postgres.database.azure.com
DB_NAME=nucleiq
DB_USER=nucleiq_admin
DB_PASSWORD=<stored-in-azure-keyvault>
DB_PORT=5432

# Alternative: Full DATABASE_URL
# DATABASE_URL=postgresql://nucleiq_admin:<password>@nucleiq-db-server.postgres.database.azure.com:5432/nucleiq?sslmode=require

# =============================================================================
# REDIS (Azure Cache for Redis)
# =============================================================================
REDIS_URL=redis://:<access-key>@nucleiq-redis.redis.cache.windows.net:6379/0
CELERY_BROKER_URL=redis://:<access-key>@nucleiq-redis.redis.cache.windows.net:6379/0

# =============================================================================
# CORS SETTINGS
# =============================================================================
CORS_ALLOWED_ORIGINS=https://nucleiq.io,https://www.nucleiq.io
FRONTEND_URL=https://nucleiq.io

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<your-email@gmail.com>
EMAIL_HOST_PASSWORD=<your-app-password>
DEFAULT_FROM_EMAIL=NucleiQ <noreply@nucleiq.io>

# =============================================================================
# STORAGE (Azure Blob Storage)
# =============================================================================
AZURE_STORAGE_ACCOUNT_NAME=nucleiqstorage
AZURE_STORAGE_ACCOUNT_KEY=<storage-key>
AZURE_STORAGE_CONTAINER_MEDIA=media
AZURE_STORAGE_CONTAINER_STATIC=static

# =============================================================================
# PAYMENT GATEWAYS
# =============================================================================
RAZORPAY_KEY_ID=<your-razorpay-key>
RAZORPAY_KEY_SECRET=<your-razorpay-secret>
RAZORPAY_WEBHOOK_SECRET=<webhook-secret>

STRIPE_SECRET_KEY=<your-stripe-secret>
STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable>
STRIPE_WEBHOOK_SECRET=<webhook-secret>

# =============================================================================
# SMS PROVIDER
# =============================================================================
SMS_PROVIDER=twilio

# Twilio
TWILIO_ACCOUNT_SID=<your-account-sid>
TWILIO_AUTH_TOKEN=<your-auth-token>
TWILIO_PHONE_NUMBER=+91xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# =============================================================================
# MONITORING
# =============================================================================
SENTRY_DSN=<your-sentry-dsn>
APPLICATION_INSIGHTS_KEY=<app-insights-instrumentation-key>

# =============================================================================
# SECURITY
# =============================================================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
