# Ultra-simple Cloud Run Dockerfile
# Just Python + Gunicorn, no Nginx/Supervisord complexity

# Stage 1: Build Frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund --prefer-offline --no-progress
COPY frontend/ ./
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# Stage 2: Build Python wheels
FROM python:3.12-slim AS backend-builder
ENV PIP_NO_CACHE_DIR=1
WORKDIR /wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ python3-dev libpq-dev \
    libopenblas-dev liblapack-dev libjpeg-dev cmake \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements/prod.txt ./requirements.txt
RUN sed -i '/face_recognition/d' requirements.txt && sed -i '/dlib/d' requirements.txt
RUN pip wheel -r requirements.txt --wheel-dir /wheels

# Stage 3: Final minimal image
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DJANGO_SETTINGS_MODULE=config.settings.cloudrun \
    PORT=8080

WORKDIR /app/backend

# Minimal runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client libpq5 curl \
    libcairo2 libpango-1.0-0 libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 libglib2.0-0 libharfbuzz0b \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Python packages
COPY --from=backend-builder /wheels /wheels
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --no-index --find-links=/wheels -r /wheels/requirements.txt && \
    pip install --no-cache-dir gunicorn whitenoise && \
    rm -rf /wheels

# Copy backend code
COPY backend/ /app/backend/

# Create directories
RUN mkdir -p /app/backend/staticfiles /app/backend/media

# Copy frontend build for whitenoise to serve
COPY --from=frontend-builder /app/frontend/dist /app/backend/frontend_dist

EXPOSE 8080

# Simple direct start - gunicorn binds to 8080 directly
CMD ["gunicorn", "config.wsgi:application", \
    "--bind", "0.0.0.0:8080", \
    "--workers", "2", \
    "--timeout", "120", \
    "--access-logfile", "-", \
    "--error-logfile", "-", \
    "--log-level", "info"]
