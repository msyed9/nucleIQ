# ==============================================================================
# NucleiQ Cloud Run Production Dockerfile
# Clean, simple, production-ready deployment
# ==============================================================================

# Stage 1: Build Frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# Stage 2: Build Python Dependencies
FROM python:3.12-slim AS backend-builder
ENV PIP_NO_CACHE_DIR=1
WORKDIR /wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ python3-dev libpq-dev \
    libopenblas-dev liblapack-dev libjpeg-dev cmake \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements/prod.txt ./requirements.txt
# Remove problematic packages that aren't needed for Cloud Run
RUN sed -i '/face_recognition/d' requirements.txt && sed -i '/dlib/d' requirements.txt
RUN pip wheel -r requirements.txt --wheel-dir /wheels

# Stage 3: Final Production Image
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DJANGO_SETTINGS_MODULE=config.settings.cloudrun \
    PORT=8080

WORKDIR /app/backend

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx supervisor \
    postgresql-client libpq5 curl \
    libcairo2 libpango-1.0-0 libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 libglib2.0-0 libharfbuzz0b \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Python packages from wheels
COPY --from=backend-builder /wheels /wheels
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --no-index --find-links=/wheels -r /wheels/requirements.txt && \
    pip install --no-cache-dir gunicorn whitenoise && \
    rm -rf /wheels

# Copy backend code
COPY backend/ /app/backend/

# Copy frontend build
COPY --from=frontend-builder /app/frontend/dist /app/frontend/dist

# Create necessary directories
RUN mkdir -p /app/backend/staticfiles /app/backend/media /var/log/supervisor

# Collect static files (using SQLite temporarily during build)
RUN DATABASE_URL=sqlite:///tmp/build.db python manage.py collectstatic --noinput --clear 2>/dev/null || true

# Copy deployment configs
COPY deploy/gcp/nginx.conf /etc/nginx/sites-available/default
COPY deploy/gcp/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Create entrypoint script
RUN echo '#!/bin/bash' > /entrypoint.sh && \
    echo 'set -e' >> /entrypoint.sh && \
    echo 'echo "=========================================="' >> /entrypoint.sh && \
    echo 'echo "NucleiQ Cloud Run Starting..."' >> /entrypoint.sh && \
    echo 'echo "=========================================="' >> /entrypoint.sh && \
    echo 'cd /app/backend' >> /entrypoint.sh && \
    echo 'exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf' >> /entrypoint.sh && \
    chmod +x /entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
