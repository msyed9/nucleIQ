# =============================================================================
# Google Cloud Run Dockerfile
# Optimized for Cloud Run's scale-to-zero and cold start performance
# Cost: ~$0-15/month depending on traffic (FREE with $300 credits)
# =============================================================================

# Stage 1: Build Frontend
FROM node:20-alpine AS frontend-builder

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund --prefer-offline --no-progress

COPY frontend/ ./

# Cloud Run provides the URL at runtime
ARG VITE_API_URL=/api
ARG VITE_WS_URL=/ws

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_WS_URL=${VITE_WS_URL}

RUN npm run build

# Stage 2: Build Backend Dependencies
FROM python:3.12-slim AS backend-builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /wheels

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ python3-dev libpq-dev \
    libopenblas-dev liblapack-dev libjpeg-dev cmake \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements/prod.txt ./requirements.txt

# Remove heavy packages to reduce image size and cold start time
RUN sed -i '/face_recognition/d' requirements.txt && \
    sed -i '/dlib/d' requirements.txt

RUN pip wheel -r requirements.txt --wheel-dir /wheels

# Stage 3: Final Production Image (optimized for Cloud Run)
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DJANGO_SETTINGS_MODULE=config.settings.cloudrun \
    PORT=8080

WORKDIR /app

# Install runtime dependencies + Nginx
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx supervisor \
    postgresql-client libpq5 \
    libopenblas0 liblapack3 \
    libcairo2 libpango-1.0-0 libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 libglib2.0-0 libharfbuzz0b \
    curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Python packages
COPY --from=backend-builder /wheels /wheels
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --no-index --find-links=/wheels -r /wheels/requirements.txt && \
    pip install --no-cache-dir gunicorn && \
    rm -rf /wheels

# Copy backend
COPY backend/ /app/backend/
WORKDIR /app/backend

# Copy frontend build
COPY --from=frontend-builder /app/frontend/dist /var/www/html

# Create directories
RUN mkdir -p /app/backend/staticfiles /app/backend/media /var/log/supervisor

# Run collectstatic during build (use SQLite to avoid DB dependency)
RUN DJANGO_SETTINGS_MODULE=config.settings.cloudrun \
    SECRET_KEY=build-time-dummy-key \
    DATABASE_URL=sqlite:///tmp/build.db \
    python manage.py collectstatic --no-input --clear 2>&1 || echo "Static collection skipped"

# Copy configs
COPY deploy/gcp/nginx.conf /etc/nginx/sites-available/default
COPY deploy/gcp/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY deploy/gcp/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Cloud Run uses PORT environment variable (default 8080)
EXPOSE 8080

# Cloud Run expects fast startup - optimize for cold starts
ENV GUNICORN_CMD_ARGS="--workers 1 --threads 8 --worker-class gthread --timeout 0"

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
